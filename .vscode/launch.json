{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/robot-brain"
      ],
      "outFiles": [
        "${workspaceFolder}/robot-brain/out/**/*.js"
      ],
      "preLaunchTask": "compile-robot-brain",
      "stopOnEntry": false
    }
  ]
}
